{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexDB",
  "mainBinaryName": "nexdb",
  "version": "1.0.20261002",
  "identifier": "org.mutantcat.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NexDB",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["sql"],
        "name": "SQL Script",
        "description": "SQL script",
        "role": "Editor",
        "mimeType": "application/sql"
      },
      {
        "ext": ["db", "sqlite", "sqlite3", "duckdb"],
        "name": "Database File",
        "description": "Database file",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/NexDB.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/NexDB.desktop"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "template": "windows/nsis/installer.nsi"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dbx"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNEYyMzE3QkJCNkM3REYKUldUZng3YTdGeU5Qa1NnTUZCRVhJVkxsOWZKQWFPVCtacUgySlNlcjRDU2RmZElCQnphd25pYUMK",
      "endpoints": ["https://dl.dbxio.com/releases/latest/latest.json", "https://github.com/Mutantcat-Working-Group/NexDB/releases/latest/download/latest.json"]
    }
  }
}
